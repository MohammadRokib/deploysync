<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.deploysync.view.profile.ProfileController"
      spacing="16" prefWidth="640" prefHeight="500">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Configuration" styleClass="title-3"/>

    <VBox spacing="16" styleClass="card">
        <GridPane hgap="10" vgap="12">
            <columnConstraints>
                <ColumnConstraints minWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Profile" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="profileCombo" editable="true" promptText="Select or type a new profile name"
                      GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>

            <Label text="Master .ear file" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <HBox spacing="0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <TextField fx:id="masterEarField" styleClass="left-pill" HBox.hgrow="ALWAYS"/>
                <Button text="Browse…" onAction="#onBrowseMasterEar" styleClass="right-pill"/>
            </HBox>

            <Label text="Host / IP" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="hostField" promptText="e.g. 192.168.10.33" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Port" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="portField" promptText="e.g. 7001" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Username" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="usernameField" promptText="e.g. weblogic" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Application Name" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="appNameField" promptText="e.g. CapitaHyper" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Target Server" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="targetField" promptText="e.g. AdminServer" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>

        <Label text="Password is never saved here - every screen always asks for it manually."
               styleClass="text-muted, text-italic"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="New" onAction="#onNew" styleClass="button-outlined"/>
            <Button fx:id="duplicateButton" text="Duplicate" onAction="#onDuplicate" styleClass="button-outlined"/>
            <Button text="Save" onAction="#onSave" styleClass="accent"/>
            <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" styleClass="danger"/>
        </HBox>

        <Label fx:id="statusLabel" wrapText="true"/>
    </VBox>
</VBox>
