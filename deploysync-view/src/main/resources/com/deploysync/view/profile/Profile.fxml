<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.deploysync.view.profile.ProfileController"
      spacing="12" prefWidth="600" prefHeight="440">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Profile"/>
        <ComboBox fx:id="profileCombo" editable="true" promptText="Select or type a new profile name"
                  HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="90"/>
        </columnConstraints>

        <Label text="Master .ear file" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="masterEarField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="Browse…" onAction="#onBrowseMasterEar" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        <Label text="Host / IP" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="hostField" promptText="e.g. 192.168.10.33" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Port" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="portField" promptText="e.g. 7001" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Username" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" promptText="e.g. weblogic" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Application Name" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="appNameField" promptText="e.g. CapitaHyper" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Target Server" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="targetField" promptText="e.g. AdminServer" GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
    </GridPane>

    <Label text="Password is never saved here - every screen always asks for it manually."
           style="-fx-font-style: italic; -fx-text-fill: #666;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="New" onAction="#onNew"/>
        <Button fx:id="duplicateButton" text="Duplicate" onAction="#onDuplicate"/>
        <Button text="Save" onAction="#onSave"/>
        <Button fx:id="deleteButton" text="Delete" onAction="#onDelete"/>
    </HBox>

    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>